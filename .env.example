# ============================================================
# ISKULTRIP SCANS — Environment Variables Template
# ============================================================
# Copy this file as .env.local and fill in your values:
#   cp .env.example .env.local
#
# ⚠️ NEVER commit your actual .env.local file! Keep secrets out of git.
# ============================================================

# ─── Firebase Client SDK (Public — visible in browser) ────
# These are safe to expose; they identify your Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Firebase Admin SDK (Private — server only!) ──────────
# ⚠️ NEVER prefix these with NEXT_PUBLIC_ — they must stay server-side.
# Generate a service account key from:
#   Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Admin Access Control ──────────────────────────────────
# Email that will have admin panel access.
# NOTE: This is exposed client-side (NEXT_PUBLIC_ prefix).
# In a future refactor, move admin role check to Firebase Custom Claims.
NEXT_PUBLIC_ADMIN_EMAIL=

# ─── Site Configuration ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/your-page
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your-channel
