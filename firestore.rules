rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────
    // Check if the requester is authenticated.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the requester is an admin.
    // 🔒 SECURITY: This is the ONLY way to get write access to public data.
    // To change the admin email, update the email string below and redeploy:
    //   firebase deploy --only firestore:rules
    function isAdminEmail() {
      return request.auth.token.email == 'bongmanga.official@gmail.com';
    }

    // ─── Public-readable, admin-writable collections ─────────
    // Anyone can READ; only the admin email can WRITE.
    // This prevents any logged-in user from deleting or modifying content.

    match /manga/{mangaId} {
      allow read: if true;
      allow write: if isAdminEmail();

      // Chapters subcollection — same rules as parent manga
      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdminEmail();
      }
    }

    match /genres/{genreId} {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /upcomingReleases/{upcomingReleaseId} {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    // ─── User-private data ──────────────────────────────────
    // Each user can only access their OWN bookmarks subcollection.
    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read, write: if isAuthenticated()
        && request.auth.uid == userId;
    }

    // ─── Manga Requests (community feature) ─────────────────
    // Anyone (even anonymous) can create a request or upvote.
    // Only admin can delete. Updates are restricted to upvote field only.
    match /requests/{requestId} {
      allow read: if true;
      allow create: if true;
      // Only allow updates to upvote-related fields (prevent tampering with status, description, etc.)
      allow update: if request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['upvotes', 'upvotedBy', 'updatedAt']);
      allow delete: if isAdminEmail();
    }
  }
}
