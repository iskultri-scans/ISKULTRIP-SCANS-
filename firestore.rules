rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requester is an admin.
    // NOTE: Firestore rules cannot read env vars. To change the admin email,
    // update the email string below and redeploy the rules:
    //   firebase deploy --only firestore:rules
    function isAdminEmail() {
      return request.auth.token.email == 'bongmanga.official@gmail.com';
    }

    // Anyone can read manga and genres
    match /manga/{mangaId} {
      allow read: if true;
      allow write: if request.auth != null && isAdminEmail();

      // Chapters subcollection
      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if request.auth != null && isAdminEmail();
      }
    }

    // Anyone can read genres
    match /genres/{genreId} {
      allow read: if true;
      allow write: if request.auth != null && isAdminEmail();
    }

    // Users can only access their own bookmarks
    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Requests: anyone can create and read; updates allowed
    match /requests/{requestId} {
      allow create: if true;
      allow update: if true;
      allow read: if true;
      allow delete: if request.auth != null;
    }

    // Announcements: anyone can read; authenticated users can write
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Notifications: only authenticated users can read and write
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Upcoming Releases: anyone can read; authenticated users can write
    match /upcomingReleases/{upcomingReleaseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
